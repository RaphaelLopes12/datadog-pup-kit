{
  "port": 4319,
  "pollIntervalSeconds": 90,
  "datadogAppUrl": "https://app.datadoghq.com",
  "pupPath": "pup",
  "openBrowserOnStart": true,
  "notifications": {
    "windowsToast": true,
    "notifyOnRecovery": true
  },
  "agent": {
    "model": "composer-2.5",
    "maximumMinutes": 10
  },
  "services": [
    {
      "name": "my-service",
      "repositoryPath": "C:/Repos/my-service",
      "monitorTags": ["service:my-service"],
      "errorLogs": {
        "query": "service:my-service env:hml status:error",
        "windowMinutes": 15,
        "threshold": 20
      }
    }
  ]
}
